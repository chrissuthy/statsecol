\item \link{falcons}: peregrine falcon counts, French Jura.
\item \link{martin}: house martin nest counts.
}

\strong{Occupancy and N-mixture models}
\itemize{
\item \link{willow}: willow tit detection/non-detection data.
\item \link{redsq}: red squirrel detection/non-detection data.
\item \link{gtit}: great tit repeated counts; \link{titgof} is goodness-of-fit output
for a model of these data.
\item \link{burnet}: six-spot burnet moth data.
\item \link{voles}: water vole patch occupancy data over four years.
}

\strong{Spatial capture-recapture}
\itemize{
\item \link{Boland} (\code{BolandCH}, \code{BolandMask}): leopard camera trap data.
\item \link{fdbears}: Fort Drum black bear hair snare data.
\item \link{ocelot1}: single-session ocelot camera trap data.
\item \link{ocelot2} (\code{edf}, \code{tdf_control}, \code{tdf_disturb}, \code{ocelot_spatial}):
two-session ocelot camera trap data.
}

\strong{Regression, smoothing and impact assessment (MT5764)}
\itemize{
\item \link{nysted}, \link{horn}: offshore wind farm impact assessment surveys.
\item \link{tobinsq}: Tobin's Q for US companies.
\item \link{simdat_nl}: simulated non-linear response data.
\item \link{biod}: species counts by plot and year.
}
